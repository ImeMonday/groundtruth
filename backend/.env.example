SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
DASHSCOPE_API_KEY=your-dashscope-key
# International endpoint. If your key is from the China console, use:
# https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Required to call /v1/chat, /v1/calls, /v1/status -- pick any long random
# string. Send it as the X-API-Key header on every request.
GROUNDTRUTH_API_KEY=change-me-to-something-random

# Optional. If set, check_alerts.py posts here when drift or the
# hallucination flag rate crosses threshold. Leave blank to just print.
SLACK_WEBHOOK_URL=

# Optional. If set, telemetry spans export here instead of the console
# (also needs: pip install opentelemetry-exporter-otlp-proto-http)
OTEL_EXPORTER_OTLP_ENDPOINT=
